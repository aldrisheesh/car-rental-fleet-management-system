// Declared foreign-key relationships
Ref profiles_id_fkey: auth.users.id - public.profiles.id [delete: cascade]
Ref vehicles_category_id_fkey: public.vehicles.category_id > public.vehicle_categories.id [delete: no action]
Ref vehicles_branch_id_fkey: public.vehicles.branch_id > public.branches.id [delete: no action]
Ref booking_requests_customer_id_fkey: public.booking_requests.customer_id > public.profiles.id [delete: restrict]
Ref booking_requests_requested_vehicle_id_fkey: public.booking_requests.requested_vehicle_id > public.vehicles.id [delete: restrict]
Ref booking_requests_assigned_vehicle_id_fkey: public.booking_requests.assigned_vehicle_id > public.vehicles.id [delete: restrict]
Ref booking_requests_pickup_branch_id_fkey: public.booking_requests.pickup_branch_id > public.branches.id [delete: restrict]
Ref booking_requests_return_branch_id_fkey: public.booking_requests.return_branch_id > public.branches.id [delete: restrict]
Ref booking_requests_assigned_by_fkey: public.booking_requests.assigned_by > public.profiles.id [delete: restrict]
Ref booking_requests_confirmed_by_fkey: public.booking_requests.confirmed_by > public.profiles.id [delete: restrict]
Ref booking_requests_resolved_by_fkey: public.booking_requests.resolved_by > public.profiles.id [delete: restrict]
Ref renter_requirement_sets_booking_id_fkey: public.booking_requests.id - public.renter_requirement_sets.booking_id [delete: restrict]
Ref renter_requirement_sets_customer_id_fkey: public.renter_requirement_sets.customer_id > public.profiles.id [delete: restrict]
Ref renter_requirement_documents_requirement_set_id_fkey: public.renter_requirement_documents.requirement_set_id > public.renter_requirement_sets.id [delete: restrict]
Ref renter_requirement_documents_booking_id_fkey: public.renter_requirement_documents.booking_id > public.booking_requests.id [delete: restrict]
Ref renter_requirement_documents_customer_id_fkey: public.renter_requirement_documents.customer_id > public.profiles.id [delete: restrict]
Ref renter_requirement_reviews_requirement_set_id_fkey: public.renter_requirement_reviews.requirement_set_id > public.renter_requirement_sets.id [delete: restrict]
Ref renter_requirement_reviews_reviewer_id_fkey: public.renter_requirement_reviews.reviewer_id > public.profiles.id [delete: restrict]
Ref renter_requirement_reviews_government_id_document_id_fkey: public.renter_requirement_reviews.government_id_document_id > public.renter_requirement_documents.id [delete: restrict]
