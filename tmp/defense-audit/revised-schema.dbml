Project briah_car_rental {
  database_type: 'PostgreSQL'
  Note: 'Database schema for the Web-Based Car Rental Management System for Briah Car Rental. Forty public tables; auth.users is an external authentication reference.'
}

Table auth.users {
  id uuid [pk, not null]
  Note: 'External authentication reference. Only the referenced primary key is shown.'
}

