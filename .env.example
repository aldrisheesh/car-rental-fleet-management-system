# Public browser configuration (safe to expose to the client bundle).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Trusted server configuration. Never prefix this key with VITE_ or expose it
# to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trusted deployment-only backup tooling. Cloudflare R2 must be a private
# Standard bucket. These credentials are never available to browser code.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=briah-car-rental-backups
BACKUP_RETENTION_DAYS=14
BACKUP_DATABASE_SOURCE=local
BACKUP_TRIGGER=Manual

# Recovery drills require an isolated non-production database and Storage
# project. The confirmation has no default and is deliberately explicit.
RECOVERY_TARGET_ENV=nonproduction
RECOVERY_DRILL_CONFIRM=RESTORE_ISOLATED_NONPRODUCTION
RECOVERY_TARGET_DATABASE_URL=postgresql://recovery-user:password@nonproduction-db.example.com:5432/postgres?sslmode=require
RECOVERY_TARGET_SUPABASE_URL=https://your-nonproduction-project-ref.supabase.co
RECOVERY_TARGET_SUPABASE_SERVICE_ROLE_KEY=your-nonproduction-service-role-key

# Trusted scheduled processor and non-secret operational policy. The low-
# availability default is provisionally 1 when this value is absent.
REMINDER_PROCESSOR_SECRET=replace-with-a-long-random-secret
LOW_AVAILABILITY_THRESHOLD=1

# Application transactional email through the Brevo API. These values are
# server-only and separate from Supabase Auth SMTP configuration.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Briah's Car Rental
APP_BASE_URL=https://your-application.example.com
# Used only by explicit live-provider validation; never as an application recipient.
BREVO_TEST_RECIPIENT=controlled-test-recipient@example.com

# Trusted external-context provider credentials. Never prefix these with VITE_
# or expose them to browser code.
GEOAPIFY_API_KEY=your-geoapify-api-key
LOCATIONIQ_API_KEY=your-locationiq-api-key
TOMTOM_API_KEY=your-tomtom-api-key
HERE_API_KEY=your-here-api-key
OPENWEATHER_API_KEY=your-openweather-one-call-api-key
