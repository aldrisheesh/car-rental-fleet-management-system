digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=polyline, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="Payments and retained quotations\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
node [shape=plain,fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=9,color="#64748b",fontcolor="#334155",arrowsize=0.6];
"payment_methods" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>payment_methods</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">label</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">instructions</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">is_demo</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">qr_image_path</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">recipient_name</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">account_number</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR></TABLE>>];
"payments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK booking_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK customer_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">currency</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">required_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">submitted_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK payment_method_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">payment_method_label</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">transaction_reference</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">resubmission_reason</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK reviewed_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reviewed_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reviewed_proof_version</TD><TD ALIGN="LEFT">int4</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reviewed_submitted_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reviewed_transaction_reference</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">submitted_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"payment_proofs" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>payment_proofs</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK payment_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK booking_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK customer_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">storage_path</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">original_filename</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">mime_type</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">size_bytes</TD><TD ALIGN="LEFT">int8</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">is_current</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">uploaded_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">superseded_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR></TABLE>>];
"booking_payment_quotes" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>booking_payment_quotes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK booking_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">daily_rate</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">pickup_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">return_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">grace_minutes</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">billable_days</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">rental_subtotal</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">delivery_fee</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">down_payment_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">remaining_balance_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">security_deposit_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">quote_version</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK issued_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">issued_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"rate_cards" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>rate_cards</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">package_code</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">package_label</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">duration_hours</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">base_rate</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">effective_from</TD><TD ALIGN="LEFT">date</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">effective_until</TD><TD ALIGN="LEFT">date</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">researcher_designed</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK created_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"booking_rate_quotes" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>booking_rate_quotes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK booking_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK rate_card_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">package_code</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">package_label</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">duration_hours</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">base_rental_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">delivery_fee</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">approved_discount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">approved_subtotal</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">required_down_payment</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">quote_version</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">researcher_designed</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK approved_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">approved_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"booking_requests" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>booking_requests</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>profiles</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"vehicles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>vehicles</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"booking_payment_quotes" -> "booking_requests" [dir=none,label="booking_id → id",taillabel="0..1",headlabel="1",labeldistance=2];
"booking_payment_quotes" -> "profiles" [dir=none,label="issued_by → id",taillabel="0..N",headlabel="1",labeldistance=2];
"booking_payment_quotes" -> "vehicles" [dir=none,label="vehicle_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"booking_rate_quotes" -> "profiles" [dir=none,label="approved_by → id",taillabel="0..N",headlabel="1",labeldistance=2];
"booking_rate_quotes" -> "booking_requests" [dir=none,label="booking_id → id",taillabel="0..1",headlabel="1",labeldistance=2];
"booking_rate_quotes" -> "rate_cards" [dir=none,label="rate_card_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"payment_proofs" -> "booking_requests" [dir=none,label="booking_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"payment_proofs" -> "profiles" [dir=none,label="customer_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"payment_proofs" -> "payments" [dir=none,label="payment_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"payments" -> "booking_requests" [dir=none,label="booking_id → id",taillabel="0..1",headlabel="1",labeldistance=2];
"payments" -> "profiles" [dir=none,label="customer_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"payments" -> "payment_methods" [dir=none,label="payment_method_id → id",taillabel="0..N",headlabel="0..1",labeldistance=2];
"payments" -> "profiles" [dir=none,label="reviewed_by → id",taillabel="0..N",headlabel="0..1",labeldistance=2];
"rate_cards" -> "profiles" [dir=none,label="created_by → id",taillabel="0..N",headlabel="1",labeldistance=2];
"rate_cards" -> "vehicles" [dir=none,label="vehicle_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
}