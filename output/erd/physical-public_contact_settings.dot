digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=ortho, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="public_contact_settings\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
