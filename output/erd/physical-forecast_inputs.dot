digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=ortho, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="forecast_inputs\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
node [shape=plain,fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=9,color="#64748b",fontcolor="#334155",arrowsize=0.6];
"forecast_inputs" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>forecast_inputs</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK forecast_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_type</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_week_start</TD><TD ALIGN="LEFT">date</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_value</TD><TD ALIGN="LEFT">numeric(18,8)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">input_order</TD><TD ALIGN="LEFT">int2</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">weight</TD><TD ALIGN="LEFT">numeric(5,4)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">weighted_contribution</TD><TD ALIGN="LEFT">numeric(18,8)</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"forecasts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>forecasts</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"forecast_inputs" -> "forecasts" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
}