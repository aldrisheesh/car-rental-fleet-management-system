digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=ortho, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="allocation_recommendations\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
node [shape=plain,fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=9,color="#64748b",fontcolor="#334155",arrowsize=0.6];
"allocation_recommendations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>allocation_recommendations</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK batch_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK source_supply_evaluation_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK destination_supply_evaluation_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK source_branch_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK destination_branch_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_category_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">forecast_horizon</TD><TD ALIGN="LEFT">int2</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">target_week_start</TD><TD ALIGN="LEFT">date</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">target_week_end</TD><TD ALIGN="LEFT">date</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_required_units_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_projected_supply_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_surplus_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">destination_required_units_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">destination_projected_supply_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">destination_shortage_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">recommended_transfer_units</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">decision_state</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">approved_transfer_units</TD><TD ALIGN="LEFT">int4</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK decided_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">decided_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"allocation_recommendation_batches" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>allocation_recommendation_batches</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"branches" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>branches</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>profiles</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"supply_evaluations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>supply_evaluations</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"vehicle_categories" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>vehicle_categories</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"allocation_recommendations" -> "allocation_recommendation_batches" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "profiles" [dir=none,taillabel="0..N",headlabel="0..1",labeldistance=2];
"allocation_recommendations" -> "branches" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "supply_evaluations" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "branches" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "supply_evaluations" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "vehicle_categories" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
}