digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=ortho, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="payments\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
node [shape=plain,fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=9,color="#64748b",fontcolor="#334155",arrowsize=0.6];
"payments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK booking_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK customer_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">currency</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">required_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">submitted_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK payment_method_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">payment_method_label</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">transaction_reference</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">resubmission_reason</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK reviewed_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reviewed_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reviewed_proof_version</TD><TD ALIGN="LEFT">int4</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reviewed_submitted_amount</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reviewed_transaction_reference</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">submitted_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"booking_requests" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>booking_requests</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"payment_methods" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>payment_methods</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>profiles</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"payments" -> "booking_requests" [dir=none,taillabel="0..1",headlabel="1",labeldistance=2];
"payments" -> "profiles" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"payments" -> "payment_methods" [dir=none,taillabel="0..N",headlabel="0..1",labeldistance=2];
"payments" -> "profiles" [dir=none,taillabel="0..N",headlabel="0..1",labeldistance=2];
}