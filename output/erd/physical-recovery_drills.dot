digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=ortho, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="recovery_drills\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
node [shape=plain,fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=9,color="#64748b",fontcolor="#334155",arrowsize=0.6];
"recovery_drills" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>recovery_drills</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK backup_run_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">target_environment</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">database_validation</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">storage_validation</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">error_code</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">remarks</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"backup_runs" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>backup_runs</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"recovery_drills" -> "backup_runs" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
}