digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=polyline, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="Briah Car Rental - full physical ERD (478 public columns)\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
