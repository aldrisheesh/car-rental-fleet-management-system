"booking_requests" -> "profiles" [dir=none,taillabel="0..N",headlabel="0..1",labeldistance=2];
"booking_requests" -> "branches" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"renter_requirement_documents" -> "booking_requests" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"renter_requirement_documents" -> "profiles" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"renter_requirement_documents" -> "renter_requirement_sets" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"renter_requirement_reviews" -> "renter_requirement_documents" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"renter_requirement_reviews" -> "renter_requirement_documents" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"renter_requirement_reviews" -> "renter_requirement_documents" [dir=none,taillabel="0..N",headlabel="0..1",labeldistance=2];
"renter_requirement_reviews" -> "renter_requirement_sets" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"renter_requirement_reviews" -> "profiles" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
"renter_requirement_reviews" -> "renter_requirement_documents" [dir=none,taillabel="0..N",headlabel="0..1",labeldistance=2];
"renter_requirement_sets" -> "booking_requests" [dir=none,taillabel="0..1",headlabel="1",labeldistance=2];
"renter_requirement_sets" -> "profiles" [dir=none,taillabel="0..N",headlabel="1",labeldistance=2];
}