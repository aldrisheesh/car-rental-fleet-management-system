digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=polyline, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="Fleet and identity\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
node [shape=plain,fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=9,color="#64748b",fontcolor="#334155",arrowsize=0.6];
"profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">phone_number</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">user_type</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">account_status</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">street_address</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">barangay</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">city_municipality</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">province</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">postal_code</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR></TABLE>>];
"branches" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>branches</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"vehicle_categories" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>vehicle_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"vehicles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>vehicles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK category_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK branch_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">license_plate</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">transmission</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">fuel_type</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">seat_capacity</TD><TD ALIGN="LEFT">int4</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">daily_rate</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reference_fuel_efficiency_km_per_liter</TD><TD ALIGN="LEFT">numeric(8,2)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">image_url</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">current_odometer_km</TD><TD ALIGN="LEFT">numeric(12,1)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">condition_blocks_rental_use</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">large_luggage_capacity</TD><TD ALIGN="LEFT">int4</TD><TD>NULL</TD></TR></TABLE>>];
"vehicle_images" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>vehicle_images</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">storage_path</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">public_url</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">alt_text</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">int2</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">is_cover</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"vehicle_operational_state_events" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>vehicle_operational_state_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">effective_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK recorded_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"auth.users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>auth.users</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"profiles" -> "auth.users" [dir=none,label="id → id",taillabel="0..1",headlabel="1",labeldistance=2];
"vehicle_images" -> "vehicles" [dir=none,label="vehicle_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"vehicle_operational_state_events" -> "auth.users" [dir=none,label="recorded_by → id",taillabel="0..N",headlabel="0..1",labeldistance=2];
"vehicle_operational_state_events" -> "vehicles" [dir=none,label="vehicle_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"vehicles" -> "branches" [dir=none,label="branch_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"vehicles" -> "vehicle_categories" [dir=none,label="category_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
}