digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.5, pad=0.4, splines=polyline, overlap=false, fontname="Arial", fontsize=20, labelloc=t, label="Supply and allocation\nPK = primary key; FK = foreign key. Labels show database-enforced multiplicity."];
node [shape=plain,fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=9,color="#64748b",fontcolor="#334155",arrowsize=0.6];
"supply_evaluations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>supply_evaluations</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK forecast_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">evaluated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK evaluated_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">idempotency_key</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">required_units_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">projected_supply</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">shortage_units</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">surplus_units</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">data_quality_state</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"supply_evaluation_vehicles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>supply_evaluation_vehicles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK evaluation_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">eligible</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">booking_conflict</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">rental_conflict</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">future_maintenance_conflict</TD><TD ALIGN="LEFT">bool</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">exclusion_reasons</TD><TD ALIGN="LEFT">jsonb</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"allocation_recommendation_batches" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>allocation_recommendation_batches</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK generated_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">generated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">idempotency_key</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">generation_context_fingerprint</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"allocation_recommendations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>allocation_recommendations</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK batch_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK source_supply_evaluation_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK destination_supply_evaluation_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK source_branch_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK destination_branch_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_category_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">forecast_horizon</TD><TD ALIGN="LEFT">int2</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">target_week_start</TD><TD ALIGN="LEFT">date</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">target_week_end</TD><TD ALIGN="LEFT">date</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_required_units_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_projected_supply_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_surplus_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">destination_required_units_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">destination_projected_supply_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">destination_shortage_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">recommended_transfer_units</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">decision_state</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">approved_transfer_units</TD><TD ALIGN="LEFT">int4</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK decided_by</TD><TD ALIGN="LEFT">uuid</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">decided_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"allocation_recommendation_candidates" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#163e5b"><FONT COLOR="white"><B>allocation_recommendation_candidates</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK recommendation_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">vehicle_name_snapshot</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">license_plate_snapshot</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">candidate_rank</TD><TD ALIGN="LEFT">int4</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">idle_days_snapshot</TD><TD ALIGN="LEFT">int4</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">idle_reference_snapshot</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">revalidation_state</TD><TD ALIGN="LEFT">text</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">explanation_codes</TD><TD ALIGN="LEFT">jsonb</TD><TD>NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NOT NULL</TD></TR></TABLE>>];
"branches" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>branches</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"forecasts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>forecasts</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>profiles</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"vehicle_categories" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>vehicle_categories</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"vehicles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#263746"><B>vehicles</B> (reference)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD><TD>NOT NULL</TD></TR></TABLE>>];
"allocation_recommendation_batches" -> "profiles" [dir=none,label="generated_by → id",taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendation_candidates" -> "allocation_recommendations" [dir=none,label="recommendation_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendation_candidates" -> "vehicles" [dir=none,label="vehicle_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "allocation_recommendation_batches" [dir=none,label="batch_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "profiles" [dir=none,label="decided_by → id",taillabel="0..N",headlabel="0..1",labeldistance=2];
"allocation_recommendations" -> "branches" [dir=none,label="destination_branch_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "supply_evaluations" [dir=none,label="destination_supply_evaluation_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "branches" [dir=none,label="source_branch_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "supply_evaluations" [dir=none,label="source_supply_evaluation_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"allocation_recommendations" -> "vehicle_categories" [dir=none,label="vehicle_category_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"supply_evaluation_vehicles" -> "supply_evaluations" [dir=none,label="evaluation_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"supply_evaluation_vehicles" -> "vehicles" [dir=none,label="vehicle_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
"supply_evaluations" -> "profiles" [dir=none,label="evaluated_by → id",taillabel="0..N",headlabel="1",labeldistance=2];
"supply_evaluations" -> "forecasts" [dir=none,label="forecast_id → id",taillabel="0..N",headlabel="1",labeldistance=2];
}